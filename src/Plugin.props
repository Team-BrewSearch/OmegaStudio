<Project>
  <PropertyGroup>
    <AssemblyName>$(OmegaPluginName).Formats</AssemblyName>
    <RootNamespace>$(OmegaPluginName).Formats</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)Omega.Plugins\Omega.Plugins.csproj"
                      Private="false"
                      ExcludeAssets="runtime" />
  </ItemGroup>
  <Target Name="CopyToFormatsFolder" AfterTargets="Build" Condition="'$(OmegaSkipFormatsCopy)' != 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(OmegaFormatsPath)" SkipUnchangedFiles="true" />
    <Message Importance="normal" Text="$(AssemblyName).dll -> $(OmegaFormatsPath)" />
  </Target>
  <Target Name="CleanFormatsFolder" AfterTargets="Clean">
    <Delete Files="$(OmegaFormatsPath)\$(AssemblyName).dll" />
  </Target>
</Project>
