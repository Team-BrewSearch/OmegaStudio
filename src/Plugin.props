<Project>
  <PropertyGroup>
    <AssemblyName>$(OmegaPluginName).Formats</AssemblyName>
    <RootNamespace>$(OmegaPluginName).Formats</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OmegaEmbeddedDependencyPrefix>omega/deps/</OmegaEmbeddedDependencyPrefix>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)Omega.Plugins\Omega.Plugins.csproj"
                      Private="false"
                      ExcludeAssets="runtime" />
  </ItemGroup>
  <Target Name="EmbedPluginDependencies"
          DependsOnTargets="ResolveReferences"
          BeforeTargets="SplitResourcesByCulture">
    <ItemGroup>
      <OmegaDependencyCandidate Include="@(ReferenceCopyLocalPaths->'%(Filename)%(Extension)')"
                                Condition="'%(Extension)' == '.dll'">
        <SourcePath>%(ReferenceCopyLocalPaths.FullPath)</SourcePath>
      </OmegaDependencyCandidate>
      <OmegaDependencyCandidate Remove="@(OmegaUnusedDependency->'%(Identity).dll')" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(OmegaDependencyCandidate)">
      <Output TaskParameter="Filtered" ItemName="OmegaDependency" />
    </RemoveDuplicates>
    <ItemGroup>
      <EmbeddedResource Include="@(OmegaDependency->'%(SourcePath)')">
        <LogicalName>$(OmegaEmbeddedDependencyPrefix)%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
    <Message Importance="normal"
             Text="$(AssemblyName): embedding @(OmegaDependency->Count()) librar(ies), leaving out @(OmegaUnusedDependency->Count()) unused" />
  </Target>
  <Target Name="CopyToFormatsFolder" AfterTargets="Build" Condition="'$(OmegaSkipFormatsCopy)' != 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(OmegaFormatsPath)" SkipUnchangedFiles="true" />
    <Message Importance="normal" Text="$(AssemblyName).dll -> $(OmegaFormatsPath)" />
  </Target>
  <Target Name="CleanFormatsFolder" AfterTargets="Clean">
    <Delete Files="$(OmegaFormatsPath)\$(AssemblyName).dll" />
  </Target>
</Project>
