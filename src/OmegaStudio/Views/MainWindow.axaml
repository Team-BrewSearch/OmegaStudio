<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OmegaStudio.ViewModels"
        xmlns:r="clr-namespace:OmegaStudio.Rendering"
        xmlns:views="clr-namespace:OmegaStudio.Views"
        xmlns:up="clr-namespace:Omega.Plugins;assembly=Omega.Plugins"
        x:Class="OmegaStudio.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainViewModel"
        Title="Omega Studio" Width="1280" Height="760"
        Background="{DynamicResource SurfaceWell}"
        FontSize="{DynamicResource FontSizeBody}"
        Icon="/Assets/icon.png">

  <!--
    Every accelerator in the app, in one place. A MenuItem's InputGesture only *draws*
    the shortcut in the flyout — it does not execute it, which is why Ctrl+O and
    Ctrl+S did nothing for as long as they had been listed in the File menu. The
    binding that makes a key work has to live on the window, so each of these fires
    whether or not the menu has ever been opened.

    A TextBox handles Ctrl+Z itself and marks the event handled, so typing in the
    search box still undoes typing rather than the last archive edit.
  -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
  </Window.KeyBindings>

  <DockPanel>

    <!-- ==================== menu ==================== -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Open" Command="{Binding OpenCommand}" InputGesture="Ctrl+O" />
        <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
        <Separator />
        <MenuItem Header="_Close" Command="{Binding CloseAllCommand}" />
        <MenuItem Header="E_xit" Command="{Binding ExitCommand}" InputGesture="Alt+F4" />
      </MenuItem>

      <!-- Both items name what they would reverse — "Undo Replace Raw" rather than a
           bare "Undo" — and disable themselves through their commands' CanExecute. -->
      <MenuItem Header="_Edit">
        <MenuItem Header="{Binding UndoLabel}" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z" />
        <MenuItem Header="{Binding RedoLabel}" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y" />
      </MenuItem>

      <!-- What loaded from formats/, and what did not. The only place the shell
           says anything about plugins at all. -->
      <MenuItem Header="F_ormats">
        <MenuItem Header="Loaded" ItemsSource="{Binding LoadedFormats}">
          <!-- Everything a plugin declares about itself, on its own lines. One
               formatted string clipped at the flyout's width and lost the file
               patterns off the end. -->
          <MenuItem.ItemTemplate>
            <DataTemplate x:DataType="vm:PluginRow">
              <StackPanel MaxWidth="460" Margin="0,3">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpaceS}">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Text="{Binding Version}" Classes="meta" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Description}" Classes="meta"
                           IsVisible="{Binding HasDescription}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Formats}" Classes="meta" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Provenance}" Classes="meta" />
              </StackPanel>
            </DataTemplate>
          </MenuItem.ItemTemplate>
        </MenuItem>
        <MenuItem Header="Failed to load"
                  IsVisible="{Binding HasFailedFormats}"
                  ItemsSource="{Binding FailedFormats}">
          <MenuItem.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <!-- Wrapped: a load failure's reason is a sentence, and clipping it
                   hides the half that says what to do about it. -->
              <TextBlock Text="{Binding}" MaxWidth="460" TextWrapping="Wrap" Margin="0,3" />
            </DataTemplate>
          </MenuItem.ItemTemplate>
        </MenuItem>
        <Separator />
        <MenuItem Header="{Binding FormatsFolder, StringFormat='Folder: {0}'}" IsEnabled="False" />
      </MenuItem>

      <!-- A dialog is the view's own business, so this one item is a click handler
           rather than a command on a view model that owns no windows. -->
      <MenuItem Header="_Help">
        <MenuItem Header="_About Omega Studio…" Click="About_OnClick" />
      </MenuItem>
    </Menu>

    <!-- ==================== status bar ==================== -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource SurfaceRaised}"
            BorderBrush="{DynamicResource Divider}"
            BorderThickness="0,1,0,0"
            Padding="{DynamicResource StatusPadding}">
      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
    </Border>

    <!-- Outliner | viewport | Properties, with min widths so no pane can be
         dragged away to nothing. -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="290" MinWidth="200" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" MinWidth="260" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="310" MinWidth="220" />
      </Grid.ColumnDefinitions>

      <!-- ==================== Outliner ==================== -->
      <Border Grid.Column="0" Classes="pane" BorderThickness="0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="toolbar" Padding="{DynamicResource PanePadding}">
            <TextBlock Text="Outliner" Classes="paneHeader" />
          </Border>

          <TextBox DockPanel.Dock="Top" Name="SearchBox"
                   Text="{Binding SearchFilter, Mode=TwoWay}"
                   PlaceholderText="Search assets"
                   Margin="8,8,8,4" />

          <TreeView ItemsSource="{Binding CurrentItems}"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                    Background="Transparent" BorderThickness="0"
                    Padding="4,0,4,8">
            <TreeView.Styles>
              <Style Selector="TreeViewItem" x:DataType="vm:TreeItemViewModel">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="ContextMenu">
                  <!-- Built from the selected node's capabilities rather than listed
                       here, so a plugin's own commands appear beside the built-in
                       ones with nothing in this file naming either. -->
                  <ContextMenu DataContext="{Binding DataContext, ElementName=RootWindow}"
                               x:DataType="vm:MainViewModel"
                               IsVisible="{Binding HasCommands}"
                               ItemsSource="{Binding Commands}">
                    <ContextMenu.ItemTemplate>
                      <DataTemplate x:DataType="vm:AssetCommandViewModel">
                        <TextBlock Text="{Binding Title}" />
                      </DataTemplate>
                    </ContextMenu.ItemTemplate>
                    <ContextMenu.Styles>
                      <Style Selector="MenuItem" x:DataType="vm:AssetCommandViewModel">
                        <Setter Property="Command" Value="{Binding Command}" />
                      </Style>
                    </ContextMenu.Styles>
                  </ContextMenu>
                </Setter>
              </Style>
            </TreeView.Styles>

            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:TreeItemViewModel">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpaceS}">
                  <!-- Kind dot: hue identifies the asset type at a glance. -->
                  <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center"
                          Background="{Binding Kind, Converter={StaticResource AssetKindBrush}}" />

                  <ItemsControl ItemsSource="{Binding HeaderSegments}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TextSegment">
                        <TextBlock Text="{Binding Text}" Classes.hit="{Binding IsHighlight}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Text="{Binding Detail}" Classes="meta" />
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <!-- ==================== centre ==================== -->
      <Grid Grid.Column="2" Background="{DynamicResource SurfaceWell}">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="140" />
          <RowDefinition Height="1" />
          <RowDefinition Height="190" MinHeight="80" />
        </Grid.RowDefinitions>

        <!-- Each tab hides itself when the selection has nothing to put in it, so
             the window shows exactly what the loaded plugins can actually do. -->
        <TabControl Grid.Row="0" SelectedIndex="{Binding SelectedPane, Mode=TwoWay}"
                    Background="{DynamicResource SurfaceWell}">

          <!-- viewport -->
          <TabItem Header="Viewport" IsVisible="{Binding HasScene}">
            <DockPanel>
              <Border DockPanel.Dock="Top" Classes="toolbar">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpaceM}">
                  <TextBlock Text="Shading" Classes="label" />
                  <ComboBox ItemsSource="{Binding ShadingModes}"
                            SelectedItem="{Binding Shading, Mode=TwoWay}"
                            MinWidth="120" />
                  <Button Content="Reset Camera" Command="{Binding ResetViewCommand}" />
                  <TextBlock Classes="meta" Text="Drag to orbit · Shift-drag to pan · Wheel to zoom"
                             Margin="8,0,0,0" />
                </StackPanel>
              </Border>

              <Grid>
                <r:GlViewport Name="Viewport"
                              Scene="{Binding ViewportScene}"
                              Shading="{Binding Shading}" />
                <!-- Transparent overlay so pointer input reaches us regardless of
                     how the GL surface is composited. -->
                <Canvas Background="Transparent"
                        PointerPressed="Overlay_OnPointerPressed"
                        PointerMoved="Overlay_OnPointerMoved"
                        PointerReleased="Overlay_OnPointerReleased"
                        PointerWheelChanged="Overlay_OnPointerWheelChanged" />
              </Grid>
            </DockPanel>
          </TabItem>

          <!-- texture -->
          <TabItem Header="Texture" IsVisible="{Binding HasImage}">
            <DockPanel Background="{DynamicResource SurfaceWell}">
              <Border DockPanel.Dock="Top" Classes="toolbar">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpaceM}">
                  <Button Content="Fit" Click="TextureFit_OnClick" />
                  <Button Content="1:1" Click="TextureActualSize_OnClick" />
                  <TextBlock Text="{Binding #TexturePreviewView.Zoom, StringFormat={}{0:P0}}"
                             FontFamily="{DynamicResource MonoFont}"
                             Foreground="{DynamicResource TextPrimary}"
                             VerticalAlignment="Center" MinWidth="52" />
                  <TextBlock Text="{Binding TextureStatus}" Classes="label" />
                  <TextBlock Classes="meta" Text="Wheel to zoom · Drag to pan" Margin="8,0,0,0" />
                </StackPanel>
              </Border>

              <views:TextureView Name="TexturePreviewView" Source="{Binding TexturePreview}" />
            </DockPanel>
          </TabItem>

          <!-- audio -->
          <TabItem Header="Audio" IsVisible="{Binding HasAudio}">
            <DockPanel Background="{DynamicResource SurfaceWell}">
              <Border DockPanel.Dock="Top" Classes="toolbar">
                <TextBlock Text="{Binding AudioStatus}" Classes="label" />
              </Border>

              <StackPanel Margin="24" Spacing="{DynamicResource SpaceL}" VerticalAlignment="Center">
                <TextBlock Text="{Binding AudioTimeDisplay}"
                           HorizontalAlignment="Center"
                           FontFamily="{DynamicResource MonoFont}"
                           FontSize="20"
                           Foreground="{DynamicResource TextPrimary}" />

                <!-- Two-way so that every way of moving a slider scrubs: thumb drag,
                     click on the track, arrow and page keys, touch. The view model
                     tells its own writes apart from the user's; see
                     AudioPositionSeconds. Thumb drag start/end are wired up in
                     code-behind because the Thumb marks its pointer events handled. -->
                <Slider Name="AudioSeek" Minimum="0" Maximum="{Binding AudioTotalSeconds}"
                        Value="{Binding AudioPositionSeconds, Mode=TwoWay}"
                        SmallChange="0.1" LargeChange="1"
                        IsEnabled="{Binding AudioIsLoaded}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Spacing="{DynamicResource SpaceM}">
                  <Button Content="Play" Command="{Binding PlayAudioCommand}"
                          IsEnabled="{Binding AudioCanPlay}" MinWidth="96" />
                  <Button Content="Pause / Resume" Command="{Binding PauseResumeAudioCommand}"
                          IsEnabled="{Binding AudioCanPauseOrResume}" MinWidth="120" />
                  <Button Content="Stop" Command="{Binding StopAudioCommand}"
                          IsEnabled="{Binding AudioCanStop}" MinWidth="96" />
                </StackPanel>
              </StackPanel>
            </DockPanel>
          </TabItem>
        </TabControl>

        <GridSplitter Grid.Row="1" ResizeDirection="Rows" HorizontalAlignment="Stretch" />

        <!-- console | animation -->
        <TabControl Grid.Row="2" Background="{DynamicResource SurfaceWell}">

          <TabItem Header="Console">
            <Border Background="{DynamicResource SurfaceWell}">
              <ScrollViewer Name="ConsoleScroll" Padding="{DynamicResource ToolbarPadding}">
                <SelectableTextBlock Text="{Binding ConsoleText}"
                                     Foreground="{DynamicResource TextSecondary}"
                                     FontFamily="{DynamicResource MonoFont}"
                                     FontSize="{DynamicResource FontSizeSmall}" />
              </ScrollViewer>
            </Border>
          </TabItem>

          <TabItem Header="Animation" IsVisible="{Binding HasAnimation}">
            <DockPanel Background="{DynamicResource SurfaceWell}">
              <Border DockPanel.Dock="Top" Classes="toolbar">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpaceM}">
                  <TextBlock Text="Clip" Classes="label" />
                  <ComboBox ItemsSource="{Binding Animation.Clips}"
                            SelectedItem="{Binding Animation.SelectedClip}"
                            MinWidth="210"
                            IsEnabled="{Binding Animation.CanSelect}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="up:AnimationClip">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Content="Play" Command="{Binding Animation.PlayCommand}"
                          IsEnabled="{Binding Animation.CanPlay}" />
                  <Button Content="Stop" Command="{Binding Animation.StopCommand}"
                          IsEnabled="{Binding Animation.IsPlaying}" />
                  <TextBlock Text="{Binding Animation.Time, StringFormat={}{0:0.00}s}"
                             FontFamily="{DynamicResource MonoFont}"
                             Foreground="{DynamicResource TextPrimary}"
                             VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
              </Border>

              <!-- Scrolls: a 49-bone skeleton is far taller than this pane. -->
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <views:DopeSheetView SelectedAnimation="{Binding Animation.SelectedClip}"
                                     CurrentTime="{Binding Animation.Time}"
                                     Duration="{Binding Animation.Duration}" />
              </ScrollViewer>
            </DockPanel>
          </TabItem>
        </TabControl>
      </Grid>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" />

      <!-- ==================== Properties ==================== -->
      <Border Grid.Column="4" Classes="pane" BorderThickness="0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="toolbar" Padding="{DynamicResource PanePadding}">
            <TextBlock Text="Properties" Classes="paneHeader" />
          </Border>

          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Properties}" Margin="10,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="up:PropertyRow">
                  <Grid ColumnDefinitions="120,*" Margin="0,3">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="label" TextWrapping="Wrap"
                               VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="value" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
