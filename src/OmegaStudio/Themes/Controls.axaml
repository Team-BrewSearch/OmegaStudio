<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="MinHeight" Value="30" />
  </Style>
  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="{DynamicResource RowHeight}" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  </Style>
  <Style Selector="Button">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    <Setter Property="Padding" Value="12,3" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="MinHeight" Value="{DynamicResource RowHeight}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
  </Style>
  <Style Selector="TextBlock.paneHeader">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeHeading}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.value">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.meta">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.hit">
    <Setter Property="Foreground" Value="{DynamicResource SearchHit}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.pane">
    <Setter Property="Background" Value="{DynamicResource SurfacePanel}" />
  </Style>
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="{DynamicResource ToolbarPadding}" />
  </Style>
</Styles>
